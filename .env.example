# Clés requises : renseigner localement, ne jamais commiter le fichier .env.
APP_KEY=
JWT_SECRET=

# Identifiants PostgreSQL utilisés par les services Docker.
DB_USERNAME=gpe_user
DB_PASSWORD=

# Port hôte PostgreSQL, lié à 127.0.0.1 uniquement (accès admin local).
POSTGRES_HOST_PORT=5433

# Origines externes autorisées en CORS (vide = same-origin uniquement).
# Exemple : CORS_ALLOWED_ORIGINS=https://gpe.example.tg
CORS_ALLOWED_ORIGINS=

# Configuration locale et timezone
APP_NAME=GPE
APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR
APP_TIMEZONE=Africa/Lome
